# Frontend variables (VITE_* values are embedded in the browser bundle).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-side variables. Configure these in Netlify Environment Variables
# with Functions scope; do not prefix secret values with VITE_.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"

ADMIN_PASSWORD_RESET_EMAIL="admin@example.com"
ADMIN_PASSWORD_RESET_TOKEN="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# n8n endpoint exposed through the currently active Cloudflare Quick Tunnel.
N8N_BASE_URL="https://YOUR_TUNNEL.trycloudflare.com"
N8N_WEBHOOK_KEY="YOUR_N8N_WEBHOOK_KEY"

# Optional / feature-specific values referenced by the project template.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="https://YOUR_SITE.netlify.app"
